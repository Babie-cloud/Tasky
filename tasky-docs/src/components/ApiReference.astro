<div class="redoc-wrap">
	<div id="redoc-container"></div>
</div>

<script is:inline src="https://cdn.redoc.ly/redoc/latest/bundles/redoc.standalone.js"></script>
<script is:inline>
	Redoc.init(
		'/openapi.json',
		{
			scrollYOffset: 80,
			hideDownloadButton: false,
			theme: {
				colors: {
					primary: { main: '#2eb85c' },
					text: { primary: '#e6edf3', secondary: '#8b949e' },
					http: {
						get: '#3fb950',
						post: '#d29922',
						put: '#58a6ff',
						delete: '#f85149',
					},
				},
				typography: {
					fontFamily: 'Plus Jakarta Sans, system-ui, sans-serif',
					headings: { fontFamily: 'Plus Jakarta Sans, system-ui, sans-serif' },
					code: { fontFamily: 'ui-monospace, monospace' },
				},
				sidebar: { backgroundColor: '#161b22', textColor: '#c9d1d9' },
				rightPanel: { backgroundColor: '#0d1117' },
			},
		},
		document.getElementById('redoc-container')
	);
</script>
